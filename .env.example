# Copy to .env and fill in. Never commit .env.
# Salt used for the salted SHA-256 customer key. Rotating the salt changes every
# customer_key, so rotate only with a re-key of downstream systems.
PIPELINE_HASH_SALT=replace-with-a-32-byte-random-string

# Reproducibility controls
PIPELINE_SEED=42
PIPELINE_AS_OF=2015-12-31

# Optional: point at a Prefect server to record flow runs.
# PREFECT_API_URL=http://127.0.0.1:4200/api
